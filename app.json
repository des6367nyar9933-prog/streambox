{
  "name": "StreamBox",
  "displayName": "StreamBox",
  "expo": {
    "name": "StreamBox",
    "slug": "streambox",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.streambox.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow StreamBox to access your microphone for voice commands with our AI assistant."
        }
      ]
    ],
    "orientation": "portrait"
  }
}
